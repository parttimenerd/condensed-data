<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>me.bechberger</groupId>
    <artifactId>condensed-data</artifactId>
    <version>0.1.2</version>
    <packaging>jar</packaging>

    <name>condensed-data</name>
    <url>https://github.com/parttimenerd/condensed-data</url>

    <licenses>
        <license>
            <name>MIT</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>parttimenerd</id>
            <name>Johannes Bechberger</name>
            <email>me@mostlynerdless.de</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git@github.com:parttimenerd/condensed-data.git</connection>
        <developerConnection>scm:git:https://github.com/parttimenerd/condensed-data.git</developerConnection>
        <url>https://github.com/parttimenerd/condensed-data</url>
    </scm>

    <inceptionYear>2024</inceptionYear>
    <description>Library for writing condensed event data</description>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <id>all-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- Produce target/condensed-data.jar as the runnable uber-jar.
                                 Unlike assembly's jar-with-dependencies, shade lets the project's
                                 own classes win over dependency classes on collision, so the
                                 vendored org.openjdk.jmc.flightrecorder.writer overrides
                                 (Chunk/MetadataImpl/RecordingImpl) actually take effect. -->
                            <finalName>${project.artifactId}</finalName>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer
                                    implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Main-Class>me.bechberger.jfr.cli.JFRCLI</Main-Class>
                                        <Premain-Class>me.bechberger.jfr.cli.agent.Agent</Premain-Class>
                                        <Agent-Class>me.bechberger.jfr.cli.agent.Agent</Agent-Class>
                                        <Launcher-Agent-Class>me.bechberger.jfr.cli.agent.ModuleOpenerAgent</Launcher-Agent-Class>
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                    </manifestEntries>
                                </transformer>
                                <transformer
                                    implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>me.bechberger.jfr.cli.JFRCLI</mainClass>
                        </manifest>
                    </archive>
                </configuration>
                <executions>
                    <execution>
                        <!-- Produces condensed-data-<version>-reader.jar: a standalone reader
                             library with no JMC, CLI, or agent classes. -->
                        <id>reader-jar</id>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>reader</classifier>
                            <archive>
                                <manifest>
                                    <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                                </manifest>
                            </archive>
                            <includes>
                                <include>me/bechberger/condensed/**</include>
                                <include>me/bechberger/JFRReader.class</include>
                                <include>me/bechberger/jfr/**</include>
                                <include>me/bechberger/cjfr/**</include>
                            </includes>
                            <!-- Exclude JMC-dependent classes (require org.openjdk.jmc.*)
                                 and CLI commands/agent (require femtocli + JDK jfr.consumer). -->
                            <excludes>
                                <exclude>me/bechberger/jfr/WritingJFRReader*.class</exclude>
                                <exclude>me/bechberger/jfr/TypeUtil*.class</exclude>
                                <exclude>me/bechberger/jfr/TypedValueUtil*.class</exclude>
                                <exclude>me/bechberger/jfr/JFREventTypedValueCombiner*.class</exclude>
                                <exclude>me/bechberger/jfr/JFREventDeduplication*.class</exclude>
                                <exclude>me/bechberger/jfr/BasicJFRWriter*.class</exclude>
                                <exclude>me/bechberger/jfr/cli/commands/**</exclude>
                                <exclude>me/bechberger/jfr/cli/agent/**</exclude>
                                <exclude>me/bechberger/jfr/cli/query/**</exclude>
                                <exclude>me/bechberger/jfr/cli/JFRCLI*.class</exclude>
                                <exclude>me/bechberger/jfr/Benchmark*.class</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.2</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*Examples.java</include>
                        <include>**/*Properties.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>2.41.1</version>
                <configuration>
                    <java>
                        <toggleOffOn/>
                        <googleJavaFormat>
                            <version>1.27.0</version>
                            <style>AOSP</style>
                            <reflowLongStrings>true</reflowLongStrings>
                        </googleJavaFormat>
                        <excludes>**/raw/**</excludes>
                        <removeUnusedImports/>
                        <importOrder/>
                        <trimTrailingWhitespace/>
                    </java>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.rudikershaw.gitbuildhook</groupId>
                <artifactId>git-build-hook-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <installHooks>
                        <pre-commit>hooks/pre-commit</pre-commit>
                    </installHooks>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>install</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- the agent tests require the agent to be packaged -->
            <plugin>
                <!-- run mvn package -DskipTests via exec plugin -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.0.0</version>
                <executions>
                    <execution>
                        <id>mvn-package-for-agent-tests</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>mvn</executable>
                            <arguments>
                                <argument>package</argument>
                                <argument>-DskipTests</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <!-- skipTests is required to avoid infinite loop of packaging and running tests -->
                    <skip>${skipTests}</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-help-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>generate-version-file</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>evaluate</goal>
                        </goals>
                        <configuration>
                            <expression>project.version</expression>
                            <output>${project.build.directory}/classes/version</output>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.14</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>publication</id>
            <build>
                <defaultGoal>deploy</defaultGoal>
                <plugins>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.8.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>ossrh</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.6.3</version>
                        <executions>
                            <execution>
                                <id>attach-javadoc</id>
                                <goals><goal>jar</goal></goals>
                                <configuration>
                                    <doclint>none</doclint>
                                    <quiet>true</quiet>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.4</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                                <configuration>
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>flatten-maven-plugin</artifactId>
                        <version>1.6.0</version>
                        <configuration>
                            <flattenMode>ossrh</flattenMode>
                        </configuration>
                        <executions>
                            <execution>
                                <id>flatten</id>
                                <phase>process-resources</phase>
                                <goals><goal>flatten</goal></goals>
                            </execution>
                            <execution>
                                <id>flatten-clean</id>
                                <phase>clean</phase>
                                <goals><goal>clean</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <!-- Publish condensed-data-reader as a standalone Maven artifact to Central.
                 Usage: mvn -Preader-publication deploy -DskipTests -P!jmc-test
                 Publishes me.bechberger:condensed-data-reader:<version> (no classifier). -->
            <id>reader-publication</id>
            <build>
                <defaultGoal>deploy</defaultGoal>
                <plugins>
                    <plugin>
                        <!-- Generate target/condensed-data-reader-<version>.pom so that
                             the deploy:deploy-file execution below can publish the reader
                             jar under its own artifactId. -->
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>generate-reader-pom</id>
                                <phase>prepare-package</phase>
                                <goals><goal>copy-resources</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>src/main/reader-pom</directory>
                                            <filtering>true</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>reader-sources</id>
                                <phase>package</phase>
                                <goals><goal>jar</goal></goals>
                                <configuration>
                                    <classifier>reader-sources</classifier>
                                    <includes>
                                        <include>me/bechberger/condensed/**</include>
                                        <include>me/bechberger/JFRReader.java</include>
                                        <include>me/bechberger/jfr/BasicJFRReader.java</include>
                                        <include>me/bechberger/jfr/CombiningJFRReader.java</include>
                                        <include>me/bechberger/jfr/Configuration.java</include>
                                        <include>me/bechberger/jfr/Universe.java</include>
                                        <include>me/bechberger/cjfr/**</include>
                                    </includes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.6.3</version>
                        <executions>
                            <execution>
                                <id>reader-javadoc</id>
                                <phase>package</phase>
                                <goals><goal>jar</goal></goals>
                                <configuration>
                                    <classifier>reader-javadoc</classifier>
                                    <sourcepath>src/main/java</sourcepath>
                                    <subpackages>me.bechberger.condensed:me.bechberger.jfr:me.bechberger.cjfr</subpackages>
                                    <doclint>none</doclint>
                                    <quiet>true</quiet>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.4</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                                <configuration>
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <!-- Deploy the reader jar as me.bechberger:condensed-data-reader:<version>
                             with its own POM, sources, and javadoc jars. -->
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-deploy-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>deploy-reader-jar</id>
                                <phase>deploy</phase>
                                <goals><goal>deploy-file</goal></goals>
                                <configuration>
                                    <repositoryId>ossrh</repositoryId>
                                    <url>https://central.sonatype.com/api/v1/publisher/upload</url>
                                    <file>${project.build.directory}/${project.artifactId}-${project.version}-reader.jar</file>
                                    <pomFile>${project.build.directory}/condensed-data-reader-pom.xml</pomFile>
                                    <sources>${project.build.directory}/${project.artifactId}-${project.version}-reader-sources.jar</sources>
                                    <javadoc>${project.build.directory}/${project.artifactId}-${project.version}-reader-javadoc.jar</javadoc>
                                    <generatePom>false</generatePom>
                                    <sign>true</sign>
                                    <updateReleaseInfo>true</updateReleaseInfo>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>flatten-maven-plugin</artifactId>
                        <version>1.6.0</version>
                        <configuration>
                            <!-- Strip profiles (and their SNAPSHOT deps) from the published POM -->
                            <flattenMode>ossrh</flattenMode>
                        </configuration>
                        <executions>
                            <execution>
                                <id>flatten</id>
                                <phase>process-resources</phase>
                                <goals><goal>flatten</goal></goals>
                            </execution>
                            <execution>
                                <id>flatten-clean</id>
                                <phase>clean</phase>
                                <goals><goal>clean</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>jmc-test</id>
            <activation><activeByDefault>true</activeByDefault></activation>
            <dependencies>
                <dependency>
                    <groupId>org.openjdk.jmc</groupId>
                    <artifactId>flightrecorder</artifactId>
                    <version>10.0.0-SNAPSHOT</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.openjdk.jmc</groupId>
                    <artifactId>common</artifactId>
                    <version>10.0.0-SNAPSHOT</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>26.0.2</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>me.bechberger.util</groupId>
            <artifactId>femtocli</artifactId>
            <version>0.4.4</version>
        </dependency>
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>1.9.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmc</groupId>
            <artifactId>flightrecorder.writer</artifactId>
            <version>9.1.2</version>
        </dependency>
        <!-- JMC parser (reader) — vendored 10.0.0-SNAPSHOT built from jmc/core.
             Declared in the jmc-test profile (active by default) so CI builds that
             lack the local JMC SNAPSHOTs can deactivate it with -P!jmc-test. -->
        <dependency>
            <groupId>me.bechberger.util</groupId>
            <artifactId>femtojson</artifactId>
            <version>0.4.1</version>
        </dependency>
        <dependency>
            <groupId>at.yawk.lz4</groupId>
            <artifactId>lz4-java</artifactId>
            <version>1.11.0</version>
        </dependency>
        <dependency>
            <groupId>me.bechberger</groupId>
            <artifactId>ap-loader-all</artifactId>
            <version>4.3-13</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <jqwik.version>1.8.2</jqwik.version>
        <assertj.version>3.27.7</assertj.version>
        <error-prone.version>2.42.0</error-prone.version>
        <error-prone-support.version>0.25.0</error-prone-support.version>
    </properties>

    <repositories>
        <repository>
            <id>maven_central</id>
            <name>Maven Central</name>
            <url>https://repo.maven.apache.org/maven2/</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>5.13.3</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>